# Which heads to load (comma-separated): face, scene, temporal
ENABLED_HEADS=face,scene,temporal

# auto picks cuda, then mps (Apple Silicon), then cpu
DEVICE=auto

# Where Hugging Face weights are cached (defaults to ./weights)
# WEIGHTS_DIR=/app/weights

# Face head: GenD checkpoint (yermandy/GenD_PE_L, yermandy/GenD_CLIP_L_14, yermandy/GenD_DINOv3_L)
GEND_MODEL=yermandy/GenD_PE_L

# Scene head: CLIP backbone and the 768->1 linear probe on top of it
SCENE_BACKBONE=openai/clip-vit-large-patch14
# SCENE_HEAD_WEIGHTS=weights/univfd_fc.pth

# Temporal head (D3). Leave D3_MIDPOINT unset until calibrated with scripts/calibrate_d3.py;
# until then the head reports its raw statistic and is left out of the verdict.
TEMPORAL_ENCODER=microsoft/xclip-base-patch16
# D3_MIDPOINT=
# D3_SCALE=0.05

# Verdict bands on the fused probability
LIKELY_AI_THRESHOLD=0.85
NO_EVIDENCE_THRESHOLD=0.35
